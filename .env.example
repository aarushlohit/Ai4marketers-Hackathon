# ============================================================
# Miracle Birds - Environment Variables Example
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ============================================================

# ── Application ──────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=change-this-to-a-random-256-bit-secret

# ── Backend API ──────────────────────────────────────────────
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# ── Frontend ─────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_SECRET=change-this-secret
NEXTAUTH_URL=http://localhost:3000

# ── Database ─────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=miracle_birds
POSTGRES_USER=miracle_birds_user
POSTGRES_PASSWORD=ashlin
DATABASE_URL=postgresql+asyncpg://miracle_birds_user:change-this-password@localhost:5432/miracle_birds

# ── Redis ────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-this-password
REDIS_URL=redis://:change-this-password@localhost:6379/0

# ── JWT Auth ─────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-random-256-bit-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── AI / LLM ─────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4-turbo
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-pro
LLM_PROVIDER=openai

# ── CRM Integrations ─────────────────────────────────────────
# Production must use real OAuth/API providers. Set true only for local mock demos.
CRM_MOCK_MODE=false
MOCK_CRM_PUBLIC_URL=http://localhost:28900
MOCK_CRM_INTERNAL_URL=http://mock_crm_provider:8900

SALESFORCE_CLIENT_ID=your-salesforce-client-id
SALESFORCE_CLIENT_SECRET=your-salesforce-client-secret

ZOHO_CLIENT_ID=your-zoho-client-id
ZOHO_CLIENT_SECRET=your-zoho-client-secret
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
SALESFORCE_API_VERSION=v58.0

HUBSPOT_CLIENT_ID=your-hubspot-client-id
HUBSPOT_CLIENT_SECRET=your-hubspot-client-secret

DYNAMICS_CLIENT_ID=your-dynamics-client-id
DYNAMICS_CLIENT_SECRET=your-dynamics-client-secret
DYNAMICS_TENANT_ID=your-azure-tenant-id
DYNAMICS_RESOURCE_URL=https://yourorg.crm.dynamics.com
DYNAMICS_INSTANCE_URL=https://yourorg.crm.dynamics.com

PIPEDRIVE_CLIENT_ID=your-pipedrive-client-id
PIPEDRIVE_CLIENT_SECRET=your-pipedrive-client-secret

FRAPPE_BASE_URL=https://your-frappe-site.example.com
FRAPPE_API_KEY=your-frappe-api-key
FRAPPE_API_SECRET=your-frappe-api-secret

# ── AWS ──────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
S3_BUCKET_ASSETS=miracle-birds-assets-dev

# ── Email (Resend) ───────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM=onboarding@resend.dev

# Legacy SMTP settings retained for local compatibility.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@miraclebirds.ai

# ── Monitoring ───────────────────────────────────────────────
SENTRY_DSN=your-sentry-dsn

# ── MLflow ───────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=miracle_birds

# ── Service Security ─────────────────────────────────────────
INTERNAL_API_KEY=change-this-internal-api-key
WEBHOOK_SECRET=change-this-webhook-secret
TRUSTED_HOSTS=localhost,127.0.0.1

# ── Service Internal URLs (used when running outside Docker) ─
AI_ENGINE_URL=http://localhost:8001
ML_ENGINE_URL=http://localhost:8002
CRM_SERVICE_URL=http://localhost:8003
SECURITY_ENGINE_URL=http://localhost:8004
WORKFLOW_ENGINE_URL=http://localhost:8005

# ── Webhook ──────────────────────────────────────────────────
# Secret used to sign outgoing webhooks from Miracle Birds
WEBHOOK_SECRET=change-this-webhook-secret
